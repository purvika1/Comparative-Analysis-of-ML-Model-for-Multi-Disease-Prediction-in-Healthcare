# Gmail SMTP Configuration for OTP Emails
# Copy this file to .env and fill in your Gmail credentials

# Your Gmail address (the email that will send OTP codes)
SMTP_EMAIL=your-email@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# See GMAIL_SETUP.md for instructions on how to generate this
SMTP_PASSWORD=your-app-password-here

# SMTP Server Settings (usually don't need to change these)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# JWT Secret Key (change this in production!)
SECRET_KEY=your-secret-key-change-in-production
